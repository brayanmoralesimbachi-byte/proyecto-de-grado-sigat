{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SIGAT",
  "version": "1.2.0",
  "identifier": "com.sigat.app",
  "build": {
    "frontendDist": "../dist/gestor-activos/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "ng serve",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SIGAT",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/fragments/cleanup.wxs"],
        "componentRefs": ["CleanupAppData"]
      }
    }
  }
}
